<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Admin – EventFrog Screen</title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <span class="nav-icon">🎪</span>
      <span>EventFrog Screen</span>
    </div>
    <div class="nav-links">
      <span class="nav-user"><%= username %></span>
      <a href="/" target="_blank" class="btn btn-outline">👁 Slideshow</a>
      <button type="button" class="btn btn-outline" id="btn-logout">Abmelden</button>
    </div>
  </nav>

  <div class="container">
    <!-- Settings Card -->
    <div class="card">
      <div class="card-header">
        <h2>⚙️ General Settings</h2>
      </div>
      <div class="card-body">
        <form id="settings-form">
          <div class="form-grid">
            <div class="form-group">
              <label>Organizer API Key (Bearer)</label>
              <input type="password" id="api_key" name="api_key" value="" placeholder="<%= settings.api_key_set ? 'Neuen Key eingeben (leer = unverändert)' : 'Organizer API Read Key' %>" autocomplete="new-password" data-key-set="<%= settings.api_key_set ? '1' : '0' %>" data-mask="<%= apiKeyMask %>" />
              <span class="hint">In Eventfrog: Einstellungen → API-Keys → Typ „Organizer API (Read)“ — nicht Public API / Embed</span>
            </div>
            <div class="form-group form-group--wide">
              <label>API-Verbindung testen</label>
              <div class="api-test-row">
                <input type="text" id="test_event_id" placeholder="Event-ID eines Screens" />
                <button type="button" class="btn btn-secondary" onclick="testEventfrogApi()">Testen</button>
              </div>
              <pre id="api-test-result" class="api-test-result hidden"></pre>
            </div>
            <div class="form-group">
              <label>Show Title</label>
              <input type="text" id="show_title" name="show_title" value="<%= settings.show_title || 'Event Information Screen' %>" placeholder="Display title" />
            </div>
            <div class="form-group">
              <label>Auto-Refresh (Sekunden)</label>
              <input type="number" id="refresh_interval" name="refresh_interval" value="<%= settings.refresh_interval || '30' %>" min="30" max="300" />
              <span class="hint">Mindestens 30 Sekunden (Eventfrog API Rate-Limit)</span>
              <span class="hint">Live-Aktualisierung für Ticket-Tabellen</span>
            </div>
          </div>
          <div class="form-actions">
            <button type="submit" class="btn btn-primary">💾 Save Settings</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Layout: Header & Footer -->
    <div class="card">
      <div class="card-header">
        <h2>🖼 Header & Footer</h2>
      </div>
      <div class="card-body">
        <form id="layout-form">
          <h3 class="layout-section-title">Header</h3>
          <div class="form-grid">
            <div class="form-group">
              <label class="checkbox-label">
                <input type="checkbox" id="header_enabled" name="header_enabled" <%= layout.header_enabled ? 'checked' : '' %> />
                <span>Header anzeigen</span>
              </label>
            </div>
            <div class="form-group form-group--wide">
              <label>Titel (Mitte)</label>
              <input type="text" id="header_title" name="header_title" value="<%= layout.header_title %>" placeholder="z. B. Weinmarkt 2026" />
            </div>
          </div>
          <div class="form-group">
            <label>Logo (links)</label>
            <input type="file" id="header_logo" name="header_logo" accept="image/*" />
            <div class="layout-preview-row">
              <% if (layout.header_logo) { %>
                <img src="<%= layout.header_logo %>" alt="Header-Logo" class="layout-preview-img" id="header-logo-preview" />
                <label class="checkbox-label">
                  <input type="checkbox" id="remove_header_logo" name="remove_header_logo" />
                  <span>Logo entfernen</span>
                </label>
              <% } else { %>
                <img src="" alt="" class="layout-preview-img hidden" id="header-logo-preview" />
              <% } %>
            </div>
            <span class="hint">Uhrzeit rechts (24h) wird automatisch angezeigt</span>
          </div>

          <h3 class="layout-section-title">Footer</h3>
          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="footer_enabled" name="footer_enabled" <%= layout.footer_enabled ? 'checked' : '' %> />
              <span>Footer anzeigen</span>
            </label>
          </div>
          <div class="form-group">
            <label>Logos (1–8, gleiche Höhe)</label>
            <div id="footer-logos-list" class="footer-logos-admin">
              <% layout.footer_logos.forEach((logo, i) => { %>
                <div class="footer-logo-item" data-path="<%= logo %>">
                  <img src="<%= logo %>" alt="Footer <%= i + 1 %>" />
                  <button type="button" class="btn btn-sm btn-danger" onclick="removeFooterLogo(this)">Entfernen</button>
                </div>
              <% }) %>
            </div>
            <input type="file" id="footer_add" name="footer_add" accept="image/*" multiple />
            <span class="hint" id="footer-count-hint"><%= layout.footer_logos.length %> / 8 Logos</span>
          </div>

          <div class="form-actions">
            <button type="button" class="btn btn-primary" onclick="saveLayout()">💾 Layout speichern</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Screens Card -->
    <div class="card">
      <div class="card-header">
        <h2>📺 Screens</h2>
        <button class="btn btn-primary" onclick="openModal()">+ Add Screen</button>
      </div>
      <div class="card-body">
        <div id="screens-list">
          <% if (screens.length === 0) { %>
            <div class="empty-state">
              <p>No screens configured yet.</p>
              <button class="btn btn-primary" onclick="openModal()">Add your first screen</button>
            </div>
          <% } else { %>
            <div class="screens-table-wrap">
              <table class="screens-table">
                <thead>
                  <tr>
                    <th>⠿</th>
                    <th>Name</th>
                    <th>Event-ID</th>
                    <th>Type</th>
                    <th>Duration</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="screens-tbody">
                  <% screens.forEach(screen => { %>
                    <tr data-id="<%= screen.id %>">
                      <td class="drag-handle">⠿</td>
                      <td class="screen-name"><%= screen.name %></td>
                      <td class="screen-event-id"><%= screen.event_id || '–' %></td>
                      <td><span class="badge badge-<%= screen.type %>"><%= screen.type %></span></td>
                      <td><%= screen.duration %>s</td>
                      <td>
                        <span class="status-dot <%= screen.active ? 'active' : 'inactive' %>"></span>
                        <%= screen.active ? 'Active' : 'Inactive' %>
                      </td>
                      <td class="actions">
                        <button class="btn btn-sm btn-secondary" onclick="editScreen(<%= screen.id %>)">✏️ Edit</button>
                        <button class="btn btn-sm btn-danger" data-id="<%= screen.id %>" data-name="<%= screen.name.replace(/"/g, '&quot;') %>" onclick="deleteScreen(this)">🗑</button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div id="modal-overlay" class="modal-overlay hidden">
    <div class="modal">
      <div class="modal-header">
        <h3 id="modal-title">Add Screen</h3>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>
      <div class="modal-body">
        <form id="screen-form" enctype="multipart/form-data">
          <input type="hidden" id="screen-id" name="id" />

          <div class="form-grid-2">
            <div class="form-group">
              <label>Name <span class="required">*</span></label>
              <input type="text" id="f-name" name="name" required placeholder="e.g. Ticket Availability" />
            </div>
            <div class="form-group">
              <label>Type <span class="required">*</span></label>
              <select id="f-type" name="type" required onchange="onTypeChange(this.value)">
                <option value="tickets">Tickets (Tabelle)</option>
                <option value="qrcode">QR Code</option>
                <option value="sponsor">Sponsor / Image</option>
              </select>
            </div>
            <div class="form-group" id="field-event-id">
              <label>Eventfrog Event-ID <span class="required">*</span></label>
              <input type="text" id="f-event-id" name="event_id" placeholder="z. B. 12345" />
              <span class="hint">Pro Screen ein Event (Multi-Event)</span>
            </div>
            <div class="form-group">
              <label>Sort Order</label>
              <input type="number" id="f-sort" name="sort_order" value="0" min="0" />
            </div>
            <div class="form-group">
              <label>Duration (seconds)</label>
              <input type="number" id="f-duration" name="duration" value="10" min="1" max="300" />
            </div>
            <div class="form-group">
              <label>Background Color</label>
              <div class="color-input-wrap">
                <input type="color" id="f-bg-color" name="background_color" value="#000000" />
                <span id="f-bg-color-val">#000000</span>
              </div>
            </div>
            <div class="form-group">
              <label>Text Color</label>
              <div class="color-input-wrap">
                <input type="color" id="f-text-color" name="text_color" value="#ffffff" />
                <span id="f-text-color-val">#ffffff</span>
              </div>
            </div>
          </div>

          <div class="form-group">
            <label>Background Image (URL or upload)</label>
            <input type="text" id="f-bg-image" name="background_image" placeholder="https://... or leave blank" />
          </div>

          <div class="form-group">
            <label id="text-content-label">Text Content</label>
            <textarea id="f-text" name="text_content" rows="2" placeholder="Optional text to display"></textarea>
            <span class="hint" id="text-content-hint"></span>
          </div>

          <div class="form-group" id="field-image">
            <label>Image (Sponsor/Display)</label>
            <input type="file" id="f-image" name="image" accept="image/*" onchange="previewImage(this)" />
            <div id="image-preview" class="image-preview hidden"></div>
          </div>

          <div class="form-group" id="field-qr-url">
            <label>QR Code URL <span class="required">*</span></label>
            <input type="url" id="f-qr-url" name="qr_url" placeholder="https://..." />
            <span class="hint">Bei Ticket-Screens optional — sonst Eventfrog-Buchungslink aus der Event-ID</span>
          </div>

          <div class="form-group">
            <label class="checkbox-label">
              <input type="checkbox" id="f-active" name="active" value="true" checked />
              <span>Active</span>
            </label>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" onclick="closeModal()">Cancel</button>
        <button class="btn btn-primary" onclick="saveScreen()">💾 Save Screen</button>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div id="toast" class="toast hidden"></div>

  <script src="/js/admin.js"></script>
  <script src="/js/admin-layout.js"></script>
</body>
</html>
