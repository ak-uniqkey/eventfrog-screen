<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= settings.show_title || 'Event Screen' %></title>
  <link rel="stylesheet" href="/css/slideshow.css" />
</head>
<body>
  <div id="slideshow">
    <header id="site-header" class="site-header hidden" aria-hidden="true">
      <div class="header-logo-wrap">
        <img id="header-logo" class="header-logo" alt="" />
      </div>
      <h1 id="header-title" class="header-title"></h1>
      <div id="header-clock" class="header-clock" aria-live="polite"></div>
    </header>

    <div id="progress-track" class="progress-track" aria-hidden="true">
      <div id="progress-bar"></div>
    </div>

    <main id="slide-main" class="slide-main">
      <div id="slide-container"></div>
    </main>

    <div id="slide-indicators" class="slide-indicators" aria-hidden="true"></div>

    <footer id="site-footer" class="site-footer hidden" aria-hidden="true">
      <div id="footer-logos" class="footer-logos"></div>
    </footer>

    <aside id="site-ticker" class="site-ticker hidden" aria-live="polite" aria-label="Laufband"></aside>
  </div>

  <script>
    let SCREENS = <%- JSON.stringify(screens) %>;
    const SETTINGS = <%- JSON.stringify(settings) %>;
  </script>
  <script src="/js/slideshow.js"></script>
</body>
</html>
